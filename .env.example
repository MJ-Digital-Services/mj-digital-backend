NODE_ENV=development
PORT=5001

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mj-digital-media
R2_PUBLIC_URL=

# mj-digital-cms (Payload blog CMS) — pinged every 5 min to drive its
# scheduled-publish job queue. CMS_CRON_SECRET must match that repo's own
# CRON_SECRET env var exactly. See src/jobs/triggerCmsScheduledPublish.job.js.
CMS_URL=https://cms.mjdigitalservices.com
CMS_CRON_SECRET=
